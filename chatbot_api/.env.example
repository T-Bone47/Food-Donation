# Chatbot environment configuration
# Copy this file to `chatbot_api/.env` and fill in real values for local development.
# Never commit the real .env file or real credentials to version control.

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_PORT=5001
CHATBOT_RATE_LIMIT_MAX=10
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGIN=http://localhost:3000
