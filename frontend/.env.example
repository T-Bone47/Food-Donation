# Frontend environment configuration
# Copy this file to `frontend/.env.local` and fill in real values for local development.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_CHATBOT_URL=http://localhost:5001
NEXT_PUBLIC_OPENCAGE_API_KEY=your-opencage-api-key
NEXT_PUBLIC_MAP_PROVIDER=google
