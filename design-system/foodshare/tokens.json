{
  "name": "FoodShare Design System Tokens",
  "version": "2.0.0",
  "typography": {
    "fontFamilies": {
      "sans": "var(--font-geist-sans), 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "var(--font-geist-mono), 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontSizes": {
      "display": { "fontSize": "2.5rem", "lineHeight": "1.15", "letterSpacing": "-0.03em", "fontWeight": "700" },
      "h1": { "fontSize": "2rem", "lineHeight": "1.2", "letterSpacing": "-0.025em", "fontWeight": "700" },
      "h2": { "fontSize": "1.5rem", "lineHeight": "1.25", "letterSpacing": "-0.02em", "fontWeight": "600" },
      "h3": { "fontSize": "1.125rem", "lineHeight": "1.35", "letterSpacing": "-0.015em", "fontWeight": "600" },
      "body": { "fontSize": "1rem", "lineHeight": "1.5", "letterSpacing": "0", "fontWeight": "400" },
      "bodySmall": { "fontSize": "0.875rem", "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "400" },
      "caption": { "fontSize": "0.75rem", "lineHeight": "1.4", "letterSpacing": "0.01em", "fontWeight": "500" },
      "code": { "fontSize": "0.8125rem", "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "500" }
    }
  },
  "colors": {
    "brand": {
      "primary": "#0F5132",
      "primaryHover": "#0A3D2A",
      "primaryActive": "#003820",
      "primaryFixed": "#B0F1C7",
      "primaryFixedDim": "#95D4AC",
      "tertiaryFixed": "#68FCBF",
      "tertiaryContainer": "#005137"
    },
    "neutrals": {
      "surface": "#FFFFFF",
      "paper": "#F8F9FF",
      "paperDeep": "#EFF4FF",
      "ink": "#0B1C30",
      "inkSoft": "#404942",
      "inkMuted": "#707971",
      "line": "#E2E8F0",
      "lineStrong": "#CBD5E1"
    },
    "lifecycle": {
      "AVAILABLE": { "bg": "#ECFDF5", "fg": "#065F46", "border": "#A7F3D0" },
      "ASSIGNED": { "bg": "#EEF2FF", "fg": "#3730A3", "border": "#C7D2FE" },
      "PICKED_UP": { "bg": "#FEF3C7", "fg": "#92400E", "border": "#FDE68A" },
      "DELIVERED": { "bg": "#E0F2FE", "fg": "#0369A1", "border": "#BAE6FD" },
      "COMPLETED": { "bg": "#CCFBF1", "fg": "#115E59", "border": "#99F6E4" },
      "CANCELLED": { "bg": "#FFE4E6", "fg": "#9F1239", "border": "#FECDD3" },
      "EXPIRED": { "bg": "#F1F5F9", "fg": "#334155", "border": "#E2E8F0" }
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem"
  },
  "radii": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "xs": "0 1px 2px rgba(11, 28, 48, 0.04)",
    "sm": "0 1px 3px rgba(11, 28, 48, 0.06), 0 1px 2px rgba(11, 28, 48, 0.04)",
    "md": "0 4px 6px -1px rgba(11, 28, 48, 0.08), 0 2px 4px -2px rgba(11, 28, 48, 0.04)",
    "lg": "0 10px 15px -3px rgba(11, 28, 48, 0.1), 0 4px 6px -4px rgba(11, 28, 48, 0.05)"
  }
}
