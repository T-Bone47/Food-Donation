# ==============================================================================
# FoodShare Platform Environment Template (.env.example)
# Copy this file to .env and configure secrets prior to deployment.
# NEVER commit raw .env files to version control.
# ==============================================================================

# --- [1. Global Orchestration & Ports] ---
NODE_ENV=production
PORT=5000
FRONTEND_PORT=3000
CHATBOT_PORT=5002

# --- [2. Managed Supabase PostgreSQL & Auth Credentials] ---
# Primary persistent database and identity provider
SUPABASE_URL=https://your-project-id.supabase.co
# Anonymous public client key (Safe for browser communication)
SUPABASE_KEY=your-supabase-anon-public-key-here
# Service role key (Backend API internal use only, NEVER exposed to client)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- [3. Session Security & Cryptography] ---
# High-entropy secret key for HMAC-SHA256 session token issuance (min 32 characters)
SESSION_SECRET=replace-with-at-least-32-chars-high-entropy-cryptographic-secret

# --- [4. Cross-Origin Resource Sharing (CORS)] ---
CORS_ORIGIN=http://localhost:3000

# --- [5. Conversational AI Microservice (Google Gemini)] ---
# Optional: Chatbot automatically operates via grounded domain knowledge if omitted
GEMINI_API_KEY=your-gemini-api-key-here
BACKEND_API_URL=http://localhost:5000/api/v1

# --- [6. Client-Side Public Envs (Frontend)] ---
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_CHATBOT_URL=http://localhost:5002

# --- [7. Background Workers & Expiry Automation] ---
EXPIRY_SWEEPER=false

