# Backend environment configuration
# Copy this file to `backend/.env` and fill in real values for local development.
# Never commit the real .env file or real credentials to version control.

NODE_ENV=development
PORT=5000

# Supabase project credentials (server-side only; never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Secret used to sign the short-lived backend session tokens (HMAC).
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:3000

# How often the server sweeps expired AVAILABLE donations (minimum 60000 ms).
EXPIRY_SWEEP_INTERVAL_MS=300000
# Set to "false" only when an external scheduler owns expiry processing.
EXPIRY_SWEEPER=true
